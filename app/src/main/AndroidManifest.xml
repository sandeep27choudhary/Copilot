<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Reading bank messages is what fills the ledger. Both permissions are optional:
        nothing is read until the user turns SMS transactions on in Settings.
    -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!--
        SMS ingestion is one input among several — CSV import, PDF import and manual entry
        all work without it — so a device with no telephony (a tablet, ChromeOS, Wear OS)
        should still be able to install the app; SMS features are simply unavailable there.
    -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!--
        There is deliberately no android.permission.INTERNET here. Without it the process
        cannot open a socket, so "your data stays on your device" is enforced by the
        platform rather than by our own good intentions.
    -->

    <application
        android:name=".CoffeeLedgerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CoffeeLedger">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CoffeeLedger">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The system delivers SMS_RECEIVED to an exported receiver only, and the
            BROADCAST_SMS permission means only the system can send it here.
        -->
        <receiver
            android:name=".sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="500">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
